{
  "name": "electron-winui",
  "version": "0.1.0-preview.1",
  "description": "Preview WinUI 3 window shell for Electron applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "electron-winui": "dist/cli.js"
  },
  "scripts": {
    "restore": "node scripts/winapp.mjs restore",
    "generate": "node scripts/winapp.mjs generate",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build && node scripts/verify-package-contents.mjs",
    "test": "npm run test:types && npm run test:unit && npm run test:smoke && npm run test:package",
    "test:unit": "npm run test:version && npm run test:reliability && npm run test:menu-role && npm run test:accessibility && npm run test:api-conformance && npm run test:package-policy",
    "test:version": "node --test test/windows-app-sdk.test.js",
    "test:reliability": "node --test test/cli.test.js test/prepare.test.js test/process.test.js test/runtime.test.js",
    "test:menu-role": "node --test test/menu-role.test.js",
    "test:accessibility": "node --test test/accessibility.test.js",
    "test:api-conformance": "node --test test/api-conformance.test.js",
    "test:package-policy": "node --test test/package-policy.test.js",
    "test:smoke": "node --test test/window.test.js",
    "test:uia": "node --test test/uia/uia-fixture.test.js",
    "test:package": "node --test test/package.test.js",
    "test:types": "tsc -p tsconfig.test.json",
    "example": "electron example/main.js",
    "pack:preview": "node scripts/pack-preview.mjs"
  },
  "keywords": [
    "electron",
    "windows",
    "winui",
    "windows-app-sdk",
    "native-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmetulev/electron-winui.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "electron": ">=43 <44"
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.19",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "0.1.0-preview.19",
    "@microsoft/winappcli": "0.6.2",
    "@types/node": "^24.0.0",
    "electron": "43.4.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.dll",
    "dist/**/*.json",
    "dist/**/*.manifest",
    "README.md"
  ],
  "winapp": {
    "jsBindings": {
      "additionalWinmds": [
        {
          "namespace": "Windows.Foundation",
          "classes": [
            "PropertyValue"
          ]
        },
        {
          "namespace": "Microsoft.UI.Dispatching",
          "classes": [
            "DispatcherQueueController"
          ]
        },
        {
          "namespace": "Microsoft.UI.Windowing",
          "classes": [
            "AppWindow"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml",
          "classes": [
            "Application"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Hosting",
          "classes": [
            "DesktopWindowXamlSource",
            "WindowsXamlManager"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Automation",
          "classes": [
            "AutomationProperties"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Controls",
          "classes": [
            "Border",
            "ContentDialog",
            "Grid",
            "Image",
            "AutoSuggestBox",
            "MenuBar",
            "MenuBarItem",
            "MenuFlyout",
            "MenuFlyoutItem",
            "MenuFlyoutSeparator",
            "ScrollViewer",
            "StackPanel",
            "SymbolIcon",
            "TextBlock"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Controls.Primitives",
          "classes": [
            "FlyoutShowOptions"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Media",
          "classes": [
            "SolidColorBrush"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Media.Imaging",
          "classes": [
            "BitmapImage",
            "SvgImageSource"
          ]
        }
      ]
    }
  },
  "optionalDependencies": {
    "@microsoft/winappcli": "0.6.2"
  }
}
